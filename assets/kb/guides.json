{
  "guides": [
    {
      "id": "gp_higher_ground",
      "title": "より高い場所へ",
      "disasterTypes": [
        "tsunami",
        "flood",
        "stormSurge"
      ],
      "tags": [
        "general",
        "principle"
      ],
      "priority": 1,
      "steps": [
        "浸水や津波の恐れがあるときは、できるだけ高い場所へ移動する",
        "河川や海に近い低地は避ける",
        "公式の避難情報を確認する"
      ],
      "source": "内閣府 国民保護・防災 https://www.bousai.go.jp/kyoiku/kokuminhogo/",
      "sourceUpdated": "2020-01-01"
    },
    {
      "id": "gp_sturdy_building",
      "title": "頑丈な建物の高い階へ",
      "disasterTypes": [
        "tsunami",
        "flood"
      ],
      "tags": [
        "general",
        "principle",
        "vertical"
      ],
      "steps": [
        "外に出られない場合は頑丈な建物の3階以上を目指す",
        "エレベーターは使わない",
        "窓から離れ構造部に近づく"
      ],
      "source": "内閣府 国民保護・防災 https://www.bousai.go.jp/kyoiku/kokuminhogo/",
      "sourceUpdated": "2020-01-01"
    },
    {
      "id": "gp_away_hazard",
