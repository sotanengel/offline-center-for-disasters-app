        "landslide",
        "flood",
        "tsunami"
      ],
      "tags": [
        "general",
        "principle"
      ],
      "steps": [
        "崖・急斜面・河川の近くから離れる",
        "海岸や堤防から離れる",
        "土砂や流木の危険がある場所を避ける"
